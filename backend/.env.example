# Backend-only environment variables (also falls back to repo root .env)
# Copy to `backend/.env` and fill in your values. Do not commit to git.

USE_LOCAL_SQLITE=0
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SECRET_KEY=<generate-a-64-char-random-string>
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
AZURE_SPEECH_KEY=<your-azure-speech-key>
AZURE_SPEECH_REGION=eastus
GEMINI_API_KEY=<your-gemini-key>
OPENAI_API_KEY=<your-openai-key>
